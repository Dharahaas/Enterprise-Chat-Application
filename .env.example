# Copy to .env on the deployment host. Secret files must remain private too.
APP_DOMAIN=assistant.example.com
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_FILE=./secrets/admin_password
GEMINI_API_KEY_FILE=./secrets/gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Leave blank when the browser and API share the same HTTPS domain.
CORS_ORIGINS=
